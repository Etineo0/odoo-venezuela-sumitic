<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="partner_demo_company_ve" model="res.partner">
        <field name="name">Empresa Demo Venezuela</field>
        <field name="vat">J-123456789</field>
        <field name="street">Av. Principal, Edificio Centro</field>
        <field name="city">Caracas</field>
        <field name="country_id" ref="base.ve"/>
        <field name="zip">1010</field>
        <field name="phone">+58 212-1234567</field>
        <field name="email">info@empresa-demo.com.ve</field>
        <field name="website">www.empresa-demo.com.ve</field>
    </record>

    <record id="demo_company_ve" model="res.company">
        <field name="name">Empresa Demo Venezuela</field>
        <field name="partner_id" ref="partner_demo_company_ve"/>
    </record>

    <function model="res.company" name="_onchange_country_id">
        <value eval="[ref('demo_company_ve')]"/>
    </function>

    <function model="res.users" name="write">
        <value eval="[ref('base.user_root'), ref('base.user_admin'), ref('base.user_demo')]"/>
        <value eval="{'company_ids': [(4, ref('l10n_ve_chart.demo_company_ve'))]}"/>
    </function>

    <function model="account.chart.template" name="try_loading">
        <value eval="[]"/>
        <value>ve</value>
        <value model="res.company" eval="obj().env.ref('l10n_ve_chart.demo_company_ve')"/>
    </function>
</odoo>
